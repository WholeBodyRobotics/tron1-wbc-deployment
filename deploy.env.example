# Copy this file to .env and export it before running deploy.sh.
# The deployment repository contains launchers only; runtime code and SDKs
# remain external and are configured here.

# Leave TRON_DEPLOY_DIR unset to use this cloned repository's runtime.
# Set it only when using a separate runtime checkout.
# TRON_DEPLOY_DIR=/absolute/path/to/tron1-rl-deploy-python
TRON_DEPLOY_ROOT=/absolute/path/to/python_runner
FASTLIO_ROOT=/absolute/path/to/FAST-LIO

ARX_SDK=/absolute/path/to/umi-deploy/arx5-sdk
ARX_CAN_SETUP=/absolute/path/to/umi-deploy/setup_arx_can.sh
ARX_PY=/absolute/path/to/miniconda3/envs/arx-py310/bin/python
ARX_ENV=/absolute/path/to/miniconda3/envs/arx-py310
DEPLOY_PY=/absolute/path/to/miniconda3/envs/deploy/bin/python
POLICY_MODEL_DIR=/absolute/path/to/policy/exported

# Optional direct workspace overrides:
# LIVOX_WS=/absolute/path/to/FAST-LIO/ros2_ws
# FASTLIO_WS=/absolute/path/to/FAST-LIO/fastlio_ws
